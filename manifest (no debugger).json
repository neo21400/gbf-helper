{
  "manifest_version": 3,
  "name": "GBF Helper",
  "version": "1.3",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "windows",
    "system.display",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://game.granbluefantasy.jp/*",
    "*://gbf.game.mbga.jp/*",
    "https://gbf.keka312.com/*",
    "https://gbf.wiki/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GBF Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://game.granbluefantasy.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "assets/*.mp3"
      ],
      "matches": [
        "*://game.granbluefantasy.jp/*",
        "*://gbf.game.mbga.jp/*"
      ]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
